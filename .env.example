# Day 7.5: Supabase optional configuration (publishable credentials only).
# Client builds embed EXPO_PUBLIC_* and make them visible to end users.
# Leave both empty to continue using local-only storage.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER set secret/service_role keys or database passwords in EXPO_PUBLIC_*.
# Never commit .env.local or credential files.
